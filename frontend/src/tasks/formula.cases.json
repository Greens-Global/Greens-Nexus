{
  "_comment": "Parse-level cases shared by the browser (formula.test.js) and the server (backend/test_task_formula.py) so the two grammars cannot drift. 'valid' must parse; each 'invalid' entry is [expression, a fragment of the error message].",
  "valid": [
    "1",
    "1 + 2 * 3",
    "(1 + 2) * 3",
    "-{Budget}",
    "--1",
    "+1",
    ".5 * 2",
    "10 % 3",
    "{Budget} - {Spent}",
    "{ Budget }",
    "{Due Date} - {Start Date}",
    "\"a\" & \"b\" & 1",
    "\"say \\\"hi\\\"\"",
    "\"back\\\\slash\"",
    "1 = 1",
    "1 != 2",
    "1 <> 2",
    "1 <= 2",
    "2 >= 1",
    "1 < 2 = TRUE",
    "TRUE",
    "false",
    "SUM(1, 2, 3)",
    "sum(1)",
    "MIN({Budget}, 5)",
    "MAX(1, 2)",
    "AVG(1, 2, 3)",
    "ROUND({Budget} / 3, 2)",
    "ROUND(1.5)",
    "ABS(-3)",
    "IF({Budget} > 100, \"High\", \"Low\")",
    "IF(TRUE, 1)",
    "AND(TRUE, 1 > 0)",
    "OR(FALSE, TRUE)",
    "NOT(ISBLANK({Budget}))",
    "DAYS({Due Date}, TODAY())",
    "TODAY()",
    "WORKDAYS({Start Date}, {Due Date})",
    "CONCAT(\"a\", {Budget}, 1)",
    "UPPER(\"a\") & LOWER(\"B\")",
    "IF(AND({Subtask Count} > 0, {Completed Subtasks} = {Subtask Count}), \"Done\", \"Open\")",
    "  1  "
  ],
  "invalid": [
    ["", "Enter a formula"],
    ["   ", "Enter a formula"],
    ["1 +", "ends too soon"],
    ["(1 + 2", "Expected \")\""],
    ["1 + 2)", "Unexpected"],
    ["{Budget", "closing }"],
    ["Budget}", "Unexpected }"],
    ["}", "Unexpected }"],
    ["{}", "Empty field name"],
    ["{  }", "Empty field name"],
    ["\"open", "closing quote"],
    ["FOO(1)", "Unknown function FOO"],
    ["constructor(1)", "Unknown function constructor"],
    ["__proto__(1)", "Unknown function __proto__"],
    ["eval(\"1\")", "Unknown function eval"],
    ["SUM", "needs parentheses"],
    ["SUM()", "SUM takes at least 1 value"],
    ["ROUND(1, 2, 3)", "ROUND takes 1 or 2 values"],
    ["TODAY(1)", "TODAY takes no values"],
    ["IF(TRUE)", "IF takes 2 or 3 values"],
    ["NOT(1, 2)", "NOT takes 1 value"],
    ["DAYS(1)", "DAYS takes 2 values"],
    ["1 2", "Unexpected"],
    ["1 ** 2", "Unexpected"],
    ["1 ^ 2", "Unexpected \"^\""],
    ["a.b", "Unexpected \".\""],
    ["{a{b}", "cannot contain {"],
    ["12abc", "after a number"],
    ["window", "Unknown function window"],
    ["[1]", "Unexpected \"[\""],
    ["1;2", "Unexpected \";\""],
    ["`x`", "Unexpected \"`\""],
    ["(((((((((((((((((((((((((((((((((((((((((((1)))))))))))))))))))))))))))))))))))))))))))", "nested too deeply"]
  ]
}
