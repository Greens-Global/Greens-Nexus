{
  "form": "schedule_c",
  "title": "Schedule C",
  "taxYear": 2025,
  "years": [2025, 2026],
  "about": "Schedule C (Form 1040), Profit or Loss From Business. Line numbers of the 2025 form; 2026 reads the same lines until the IRS publishes it.",
  "reports": [
    {
      "key": "schedule-c",
      "label": "Schedule C (Draft)",
      "basis": "pl",
      "rows": [
        { "heading": "Part I - Income" },
        { "line": "1", "label": "Gross receipts or sales", "sign": 1, "group": "income" },
        { "line": "2", "label": "Returns and allowances", "sign": -1, "group": "income" },
        { "line": "3", "label": "Subtract line 2 from line 1", "calc": ["1", "-2"] },
        { "line": "4", "label": "Cost of goods sold", "sign": -1, "group": "income" },
        { "line": "5", "label": "Gross profit", "calc": ["3", "-4"] },
        { "line": "6", "label": "Other income", "sign": 1, "group": "income" },
        { "line": "7", "label": "Gross income", "calc": ["5", "6"] },
        { "heading": "Part II - Expenses" },
        { "line": "8", "label": "Advertising", "sign": -1, "group": "expenses" },
        { "line": "9", "label": "Car and truck expenses", "sign": -1, "group": "expenses" },
        { "line": "10", "label": "Commissions and fees", "sign": -1, "group": "expenses" },
        { "line": "11", "label": "Contract labor", "sign": -1, "group": "expenses" },
        { "line": "12", "label": "Depletion", "sign": -1, "group": "expenses" },
        { "line": "13", "label": "Depreciation and section 179 expense deduction", "sign": -1, "group": "expenses" },
        { "line": "14", "label": "Employee benefit programs", "sign": -1, "group": "expenses" },
        { "line": "15", "label": "Insurance (other than health)", "sign": -1, "group": "expenses" },
        { "line": "16a", "label": "Interest - mortgage (paid to banks, etc.)", "sign": -1, "group": "expenses" },
        { "line": "16b", "label": "Interest - other", "sign": -1, "group": "expenses" },
        { "line": "17", "label": "Legal and professional services", "sign": -1, "group": "expenses" },
        { "line": "18", "label": "Office expense", "sign": -1, "group": "expenses" },
        { "line": "19", "label": "Pension and profit-sharing plans", "sign": -1, "group": "expenses" },
        { "line": "20a", "label": "Rent or lease - vehicles, machinery, and equipment", "sign": -1, "group": "expenses" },
        { "line": "20b", "label": "Rent or lease - other business property", "sign": -1, "group": "expenses" },
        { "line": "21", "label": "Repairs and maintenance", "sign": -1, "group": "expenses" },
        { "line": "22", "label": "Supplies", "sign": -1, "group": "expenses" },
        { "line": "23", "label": "Taxes and licenses", "sign": -1, "group": "expenses" },
        { "line": "24a", "label": "Travel", "sign": -1, "group": "expenses" },
        { "line": "24b", "label": "Deductible meals", "sign": -1, "group": "expenses" },
        { "line": "25", "label": "Utilities", "sign": -1, "group": "expenses" },
        { "line": "26", "label": "Wages (less employment credits)", "sign": -1, "group": "expenses" },
        { "line": "27a", "label": "Energy efficient commercial bldgs deduction", "sign": -1, "group": "expenses" },
        { "line": "27b", "label": "Other expenses", "sign": -1, "group": "expenses" },
        { "line": "28", "label": "Total expenses", "calc": ["@group:expenses"] },
        { "line": "29", "label": "Tentative profit or (loss)", "calc": ["7", "-28"] },
        { "line": "30", "label": "Expenses for business use of your home", "sign": -1, "group": "home" },
        { "line": "31", "label": "Net profit or (loss)", "calc": ["29", "-30"], "grand": true }
      ],
      "summary": [["Gross Income (Line 7)", "7"], ["Total Expenses (Line 28)", "28"], ["Net Profit (Line 31)", "31", "tone"]],
      "notes": [
        "Line 30 holds only accounts mapped to it (Form 8829 is not worked out here). Line 13 is the depreciation the books carry - Form 4562 is not worked out here."
      ]
    }
  ],
  "suggest": {
    "never": "income tax|federal tax|state tax|owner|draw|distribution",
    "revenue": [["return|allowance|refund|discount", "2"], ["", "1"]],
