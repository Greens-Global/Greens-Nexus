{
  "form": "schedule_e",
  "title": "Schedule E",
  "taxYear": 2025,
  "years": [2025, 2026],
  "about": "Schedule E (Form 1040), Supplemental Income and Loss. Line numbers of the 2025 form; 2026 reads the same lines until the IRS publishes it.",
  "reports": [
    {
      "key": "schedule-e",
      "label": "Schedule E (Draft)",
      "basis": "pl",
      "columns": "entities",
      "rows": [
        { "heading": "Part I - Income or Loss From Rental Real Estate and Royalties" },
        { "line": "3", "label": "Rents received", "sign": 1, "group": "income" },
        { "line": "4", "label": "Royalties received", "sign": 1, "group": "income" },
        { "line": "5", "label": "Advertising", "sign": -1, "group": "expenses" },
        { "line": "6", "label": "Auto and travel", "sign": -1, "group": "expenses" },
        { "line": "7", "label": "Cleaning and maintenance", "sign": -1, "group": "expenses" },
        { "line": "8", "label": "Commissions", "sign": -1, "group": "expenses" },
        { "line": "9", "label": "Insurance", "sign": -1, "group": "expenses" },
        { "line": "10", "label": "Legal and other professional fees", "sign": -1, "group": "expenses" },
        { "line": "11", "label": "Management fees", "sign": -1, "group": "expenses" },
        { "line": "12", "label": "Mortgage interest paid to banks, etc.", "sign": -1, "group": "expenses" },
        { "line": "13", "label": "Other interest", "sign": -1, "group": "expenses" },
        { "line": "14", "label": "Repairs", "sign": -1, "group": "expenses" },
        { "line": "15", "label": "Supplies", "sign": -1, "group": "expenses" },
        { "line": "16", "label": "Taxes", "sign": -1, "group": "expenses" },
        { "line": "17", "label": "Utilities", "sign": -1, "group": "expenses" },
        { "line": "18", "label": "Depreciation expense or depletion", "sign": -1, "group": "expenses" },
        { "line": "19", "label": "Other", "sign": -1, "group": "expenses" },
        { "line": "20", "label": "Total expenses", "calc": ["@group:expenses"] },
        { "line": "21", "label": "Income or (loss) - lines 3 and 4 less line 20", "calc": ["3", "4", "-20"] },
        { "line": "22", "label": "Deductible rental real estate loss after limitation", "manual": "Form 8582 - not from the books" },
        { "heading": "Part I - All Properties" },
        { "line": "23a", "label": "Total of all amounts on line 3", "calc": ["3"], "totalOnly": true },
        { "line": "23b", "label": "Total of all amounts on line 4", "calc": ["4"], "totalOnly": true },
        { "line": "23c", "label": "Total of all amounts on line 12", "calc": ["12"], "totalOnly": true },
        { "line": "23d", "label": "Total of all amounts on line 18", "calc": ["18"], "totalOnly": true },
        { "line": "23e", "label": "Total of all amounts on line 20", "calc": ["20"], "totalOnly": true },
        { "line": "24", "label": "Income - the positive amounts on line 21", "calc": ["@pos:21"], "totalOnly": true },
        { "line": "25", "label": "Losses - the losses on line 21, before the Form 8582 limitation", "calc": ["@neg:21"], "totalOnly": true },
        { "line": "26", "label": "Total rental real estate and royalty income or (loss)", "calc": ["24", "25"], "totalOnly": true },
        { "heading": "Part II - Income or Loss From Partnerships and S Corporations" },
        { "line": "28h", "num": "28(h)", "label": "Passive income from Schedule K-1", "sign": 1, "group": "k1" },
        { "line": "28k", "num": "28(k)", "label": "Nonpassive income from Schedule K-1", "sign": 1, "group": "k1" },
        { "line": "28g", "num": "28(g)", "label": "Passive loss allowed", "sign": -1, "group": "k1loss" },
        { "line": "28i", "num": "28(i)", "label": "Nonpassive loss allowed from Schedule K-1", "sign": -1, "group": "k1loss" },
        { "line": "32", "label": "Total partnership and S corporation income or (loss)", "calc": ["28h", "28k", "-28g", "-28i"] },
        { "heading": "Part V - Summary" },
        { "line": "41", "label": "Total income or (loss) - lines 26 and 32 (Parts III and IV are not from these books)", "calc": ["26", "32"], "grand": true, "totalOnly": true }
      ],
      "summary": [["Rents (Line 23a)", "23a"], ["Total Expenses (Line 23e)", "23e"], ["Total (Line 41)", "41", "tone"]],
      "notes": [
        "One column per entity picked - each entity is a property (Part I columns A, B, C ...); the Total column carries lines 23 to 26 and 41. Pick no entity and every entity reads as one property.",
        "Line 25 is the losses on line 21 before the passive activity limitation - Form 8582 (line 22) is the preparer's. Part II lines read only accounts mapped to them: the K-1 figures this person's own books carry.",
        "Line 18 is the depreciation the books carry - Form 4562 is not worked out here."
      ]
    }
  ],
  "suggest": {
