        { "line": "l6", "num": "6", "label": "Other current assets", "sign": 1, "group": "assets" },
        { "line": "l7a", "num": "7a", "label": "Loans to partners (or persons related to partners)", "sign": 1, "group": "assets" },
        { "line": "l7b", "num": "7b", "label": "Mortgage and real estate loans", "sign": 1, "group": "assets" },
        { "line": "l8", "num": "8", "label": "Other investments", "sign": 1, "group": "assets" },
        { "line": "l9a", "num": "9a", "label": "Buildings and other depreciable assets", "sign": 1, "group": "assets" },
        { "line": "l9b", "num": "9b", "label": "Less accumulated depreciation", "sign": 1, "group": "assets" },
        { "line": "l10a", "num": "10a", "label": "Depletable assets", "sign": 1, "group": "assets" },
        { "line": "l10b", "num": "10b", "label": "Less accumulated depletion", "sign": 1, "group": "assets" },
        { "line": "l11", "num": "11", "label": "Land (net of any amortization)", "sign": 1, "group": "assets" },
        { "line": "l12a", "num": "12a", "label": "Intangible assets (amortizable only)", "sign": 1, "group": "assets" },
        { "line": "l12b", "num": "12b", "label": "Less accumulated amortization", "sign": 1, "group": "assets" },
        { "line": "l13", "num": "13", "label": "Other assets", "sign": 1, "group": "assets" },
        { "line": "l14", "num": "14", "label": "Total assets", "calc": ["@group:assets"] },
        { "heading": "Schedule L - Liabilities and Capital", "prefix": "Schedule L " },
        { "line": "l15", "num": "15", "label": "Accounts payable", "sign": 1, "group": "claims" },
        { "line": "l16", "num": "16", "label": "Mortgages, notes, bonds payable in less than 1 year", "sign": 1, "group": "claims" },
        { "line": "l17", "num": "17", "label": "Other current liabilities", "sign": 1, "group": "claims" },
        { "line": "l18", "num": "18", "label": "All nonrecourse loans", "sign": 1, "group": "claims" },
        { "line": "l19a", "num": "19a", "label": "Loans from partners (or persons related to partners)", "sign": 1, "group": "claims" },
        { "line": "l19b", "num": "19b", "label": "Mortgages, notes, bonds payable in 1 year or more", "sign": 1, "group": "claims" },
        { "line": "l20", "num": "20", "label": "Other liabilities", "sign": 1, "group": "claims" },
        { "line": "l21", "num": "21", "label": "Partners' capital accounts", "sign": 1, "group": "claims" },
        { "line": "l22", "num": "22", "label": "Total liabilities and capital", "calc": ["@group:claims"], "grand": true },
        { "line": "lchk", "num": "-", "label": "Line 14 less line 22 (should be 0)", "calc": ["l14", "-l22"] }
      ],
      "summary": [["Total Assets (Line 14)", "l14"], ["Total Liabilities and Capital (Line 22)", "l22"], ["Out of Balance", "lchk"]],
      "notes": [
        "Beginning of the tax year = the balance sheet the day before the period starts; end of the tax year = the balance sheet on its last day. A contra account (accumulated depreciation, an allowance) keeps its minus sign on its own line.",
        "This year's earnings not yet closed to equity and the prior years' retained earnings sit on line 21 with the partners' capital, so the two totals agree."
      ]
    }
  ],
