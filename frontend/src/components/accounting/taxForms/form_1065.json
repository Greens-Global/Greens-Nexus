{
  "form": "form_1065",
  "title": "Form 1065",
  "taxYear": 2025,
  "years": [2025, 2026],
  "about": "Form 1065, U.S. Return of Partnership Income: page 1, Form 8825 (rental real estate), Schedule K, Schedule M-1 and Schedule L. Line numbers of the 2025 forms; 2026 reads the same lines until the IRS publishes them.",
  "reports": [
    {
      "key": "tax-1065",
      "label": "Form 1065 (Draft)",
      "basis": "pl",
      "rows": [
        { "heading": "Page 1 - Income" },
        { "line": "1a", "label": "Gross receipts or sales", "sign": 1, "group": "income" },
        { "line": "1b", "label": "Returns and allowances", "sign": -1, "group": "income" },
        { "line": "1c", "label": "Balance - line 1a less line 1b", "calc": ["1a", "-1b"] },
        { "line": "2", "label": "Cost of goods sold (Form 1125-A)", "sign": -1, "group": "income" },
        { "line": "3", "label": "Gross profit", "calc": ["1c", "-2"] },
        { "line": "4", "label": "Ordinary income (loss) from other partnerships, estates, and trusts", "sign": 1, "group": "income" },
        { "line": "5", "label": "Net farm profit (loss)", "sign": 1, "group": "income" },
        { "line": "6", "label": "Net gain (loss) from Form 4797", "sign": 1, "group": "income" },
        { "line": "7", "label": "Other income (loss)", "sign": 1, "group": "income" },
        { "line": "8", "label": "Total income (loss)", "calc": ["3", "4", "5", "6", "7"] },
        { "heading": "Page 1 - Deductions" },
        { "line": "9", "label": "Salaries and wages (other than to partners)", "sign": -1, "group": "deductions" },
        { "line": "10", "label": "Guaranteed payments to partners", "sign": -1, "group": "deductions" },
        { "line": "11", "label": "Repairs and maintenance", "sign": -1, "group": "deductions" },
        { "line": "12", "label": "Bad debts", "sign": -1, "group": "deductions" },
        { "line": "13", "label": "Rent", "sign": -1, "group": "deductions" },
        { "line": "14", "label": "Taxes and licenses", "sign": -1, "group": "deductions" },
        { "line": "15", "label": "Interest", "sign": -1, "group": "deductions" },
        { "line": "16a", "label": "Depreciation", "sign": -1, "group": "deductions" },
        { "line": "16b", "label": "Less depreciation reported on Form 1125-A and elsewhere on return", "manual": "the preparer's - not from the books" },
        { "line": "16c", "label": "Depreciation less line 16b", "calc": ["16a"] },
        { "line": "17", "label": "Depletion", "sign": -1, "group": "deductions" },
        { "line": "18", "label": "Retirement plans, etc.", "sign": -1, "group": "deductions" },
        { "line": "19", "label": "Employee benefit programs", "sign": -1, "group": "deductions" },
        { "line": "20", "label": "Energy efficient commercial buildings deduction", "sign": -1, "group": "deductions" },
        { "line": "21", "label": "Other deductions", "sign": -1, "group": "deductions" },
        { "line": "22", "label": "Total deductions", "calc": ["@group:deductions"] },
        { "line": "23", "label": "Ordinary business income (loss)", "calc": ["8", "-22"] },
        { "heading": "Form 8825 - Rental Real Estate Income and Expenses", "prefix": "Form 8825 " },
        { "line": "r2", "num": "2", "label": "Gross rents", "sign": 1, "group": "rental" },
        { "line": "r3", "num": "3", "label": "Advertising", "sign": -1, "group": "rentalexp" },
        { "line": "r4", "num": "4", "label": "Auto and travel", "sign": -1, "group": "rentalexp" },
        { "line": "r5", "num": "5", "label": "Cleaning and maintenance", "sign": -1, "group": "rentalexp" },
        { "line": "r6", "num": "6", "label": "Commissions", "sign": -1, "group": "rentalexp" },
        { "line": "r7", "num": "7", "label": "Insurance", "sign": -1, "group": "rentalexp" },
        { "line": "r8", "num": "8", "label": "Legal and other professional fees", "sign": -1, "group": "rentalexp" },
        { "line": "r9", "num": "9", "label": "Interest", "sign": -1, "group": "rentalexp" },
        { "line": "r10", "num": "10", "label": "Repairs", "sign": -1, "group": "rentalexp" },
        { "line": "r11", "num": "11", "label": "Taxes", "sign": -1, "group": "rentalexp" },
        { "line": "r12", "num": "12", "label": "Utilities", "sign": -1, "group": "rentalexp" },
        { "line": "r13", "num": "13", "label": "Wages and salaries", "sign": -1, "group": "rentalexp" },
        { "line": "r14", "num": "14", "label": "Depreciation", "sign": -1, "group": "rentalexp" },
        { "line": "r15", "num": "15", "label": "Other", "sign": -1, "group": "rentalexp" },
        { "line": "r16", "num": "16", "label": "Total expenses", "calc": ["@group:rentalexp"] },
        { "line": "r21", "num": "21", "label": "Net income (loss) from rental real estate activities", "calc": ["r2", "-r16"] },
        { "heading": "Schedule K - Partners' Distributive Share Items", "prefix": "Schedule K " },
        { "line": "k1", "num": "1", "label": "Ordinary business income (loss) - page 1, line 23", "calc": ["23"] },
        { "line": "k2", "num": "2", "label": "Net rental real estate income (loss) - Form 8825", "calc": ["r21"] },
        { "line": "k3a", "num": "3a", "label": "Other gross rental income (loss)", "sign": 1, "group": "k" },
        { "line": "k3b", "num": "3b", "label": "Expenses from other rental activities", "sign": -1, "group": "kexp" },
        { "line": "k3c", "num": "3c", "label": "Other net rental income (loss)", "calc": ["k3a", "-k3b"] },
        { "line": "k4c", "num": "4c", "label": "Guaranteed payments - page 1, line 10", "calc": ["10"] },
        { "line": "k5", "num": "5", "label": "Interest income", "sign": 1, "group": "k" },
        { "line": "k6a", "num": "6a", "label": "Ordinary dividends", "sign": 1, "group": "k" },
        { "line": "k7", "num": "7", "label": "Royalties", "sign": 1, "group": "k" },
        { "line": "k8", "num": "8", "label": "Net short-term capital gain (loss)", "sign": 1, "group": "k" },
        { "line": "k9a", "num": "9a", "label": "Net long-term capital gain (loss)", "sign": 1, "group": "k" },
        { "line": "k10", "num": "10", "label": "Net section 1231 gain (loss)", "sign": 1, "group": "k" },
        { "line": "k11", "num": "11", "label": "Other income (loss)", "sign": 1, "group": "k" },
        { "line": "k12", "num": "12", "label": "Section 179 deduction", "sign": -1, "group": "kexp" },
        { "line": "k13a", "num": "13a", "label": "Contributions", "sign": -1, "group": "kexp" },
        { "line": "k13b", "num": "13b", "label": "Investment interest expense", "sign": -1, "group": "kexp" },
        { "line": "k13d", "num": "13d", "label": "Other deductions", "sign": -1, "group": "kexp" },
        { "line": "k19a", "num": "19a", "label": "Distributions of cash and marketable securities", "manual": "from the partners' distribution accounts - not an income statement figure" },
        { "line": "ka1", "num": "Analysis 1", "label": "Net income (loss) - Schedule K lines 1 through 11, less lines 12 through 13d", "calc": ["k1", "k2", "k3c", "k4c", "k5", "k6a", "k7", "k8", "k9a", "k10", "k11", "-k12", "-k13a", "-k13b", "-k13d"], "grand": true },
        { "heading": "Schedule M-1 - Net Income per Books to Income per Return", "prefix": "Schedule M-1 " },
        { "line": "m1", "num": "1", "label": "Net income (loss) per books", "calc": ["@net"] },
        { "line": "m3", "num": "3", "label": "Guaranteed payments", "calc": ["k4c"] },
        { "line": "mskip", "num": "-", "label": "Book items that are not on the return (accounts mapped Not on This Form)", "calc": ["-@skipnet"] },
        { "line": "munm", "num": "-", "label": "Accounts not mapped yet", "calc": ["-@unmappednet"] },
        { "line": "m9", "num": "9", "label": "Income (loss) - Analysis of Net Income (Loss), line 1", "calc": ["ka1"] },
        { "line": "mchk", "num": "-", "label": "Difference left to explain (should be 0)", "calc": ["m9", "-m1", "-m3", "-mskip", "-munm"] }
      ],
      "summary": [["Total Income (Line 8)", "8"], ["Ordinary Income (Line 23)", "23"], ["Rental Real Estate (K Line 2)", "k2"], ["Analysis Line 1", "ka1", "tone"]],
      "notes": [
        "Rental real estate goes on Form 8825 and Schedule K line 2, not page 1 - an entity whose revenue is mostly rent gets 8825 lines suggested. Portfolio income (interest, dividends, gains) goes on Schedule K, not page 1.",
        "Lines 16b and 19a and the tax and payment lines (24 to 33) are the preparer's. Line 16a is the depreciation the books carry - Form 4562 is not worked out here."
      ]
    },
    {
      "key": "tax-1065-l",
      "label": "Form 1065 Schedule L (Draft)",
      "basis": "bs",
      "rows": [
        { "heading": "Schedule L - Assets", "prefix": "Schedule L " },
        { "line": "l1", "num": "1", "label": "Cash", "sign": 1, "group": "assets" },
