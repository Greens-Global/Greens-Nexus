{
  "form": "form_1120",
  "title": "Form 1120",
  "taxYear": 2025,
  "years": [2025, 2026],
  "about": "Form 1120, U.S. Corporation Income Tax Return: page 1 to line 28, Schedule M-1 and Schedule L. Line numbers of the 2025 form; 2026 reads the same lines until the IRS publishes it.",
  "reports": [
    {
      "key": "tax-1120",
      "label": "Form 1120 (Draft)",
      "basis": "pl",
      "rows": [
        { "heading": "Page 1 - Income" },
        { "line": "1a", "label": "Gross receipts or sales", "sign": 1, "group": "income" },
        { "line": "1b", "label": "Returns and allowances", "sign": -1, "group": "income" },
        { "line": "1c", "label": "Balance - line 1a less line 1b", "calc": ["1a", "-1b"] },
        { "line": "2", "label": "Cost of goods sold (Form 1125-A)", "sign": -1, "group": "income" },
        { "line": "3", "label": "Gross profit", "calc": ["1c", "-2"] },
        { "line": "4", "label": "Dividends and inclusions (Schedule C)", "sign": 1, "group": "income" },
        { "line": "5", "label": "Interest", "sign": 1, "group": "income" },
        { "line": "6", "label": "Gross rents", "sign": 1, "group": "income" },
        { "line": "7", "label": "Gross royalties", "sign": 1, "group": "income" },
        { "line": "8", "label": "Capital gain net income (Schedule D)", "sign": 1, "group": "income" },
        { "line": "9", "label": "Net gain or (loss) from Form 4797", "sign": 1, "group": "income" },
        { "line": "10", "label": "Other income", "sign": 1, "group": "income" },
        { "line": "11", "label": "Total income", "calc": ["3", "4", "5", "6", "7", "8", "9", "10"] },
        { "heading": "Page 1 - Deductions" },
        { "line": "12", "label": "Compensation of officers (Form 1125-E)", "sign": -1, "group": "deductions" },
        { "line": "13", "label": "Salaries and wages (less employment credits)", "sign": -1, "group": "deductions" },
        { "line": "14", "label": "Repairs and maintenance", "sign": -1, "group": "deductions" },
        { "line": "15", "label": "Bad debts", "sign": -1, "group": "deductions" },
        { "line": "16", "label": "Rents", "sign": -1, "group": "deductions" },
        { "line": "17", "label": "Taxes and licenses", "sign": -1, "group": "deductions" },
        { "line": "18", "label": "Interest", "sign": -1, "group": "deductions" },
        { "line": "19", "label": "Charitable contributions", "sign": -1, "group": "deductions" },
        { "line": "20", "label": "Depreciation from Form 4562 not claimed on Form 1125-A or elsewhere", "sign": -1, "group": "deductions" },
        { "line": "21", "label": "Depletion", "sign": -1, "group": "deductions" },
        { "line": "22", "label": "Advertising", "sign": -1, "group": "deductions" },
        { "line": "23", "label": "Pension, profit-sharing, etc., plans", "sign": -1, "group": "deductions" },
        { "line": "24", "label": "Employee benefit programs", "sign": -1, "group": "deductions" },
        { "line": "25", "label": "Energy efficient commercial buildings deduction", "sign": -1, "group": "deductions" },
        { "line": "26", "label": "Other deductions", "sign": -1, "group": "deductions" },
        { "line": "27", "label": "Total deductions", "calc": ["@group:deductions"] },
        { "line": "28", "label": "Taxable income before net operating loss deduction and special deductions", "calc": ["11", "-27"], "grand": true },
        { "line": "29a", "label": "Net operating loss deduction", "manual": "the preparer's - not from the books" },
        { "line": "29b", "label": "Special deductions (Schedule C)", "manual": "the preparer's - not from the books" },
        { "heading": "Schedule M-1 - Income per Books to Income per Return", "prefix": "Schedule M-1 " },
        { "line": "m1", "num": "1", "label": "Net income (loss) per books", "calc": ["@net"] },
        { "line": "mskip", "num": "-", "label": "Book items that are not on the return (accounts mapped Not on This Form, such as federal income tax)", "calc": ["-@skipnet"] },
        { "line": "munm", "num": "-", "label": "Accounts not mapped yet", "calc": ["-@unmappednet"] },
        { "line": "m10", "num": "10", "label": "Income - page 1, line 28", "calc": ["28"] },
        { "line": "mchk", "num": "-", "label": "Difference left to explain (should be 0)", "calc": ["m10", "-m1", "-mskip", "-munm"] }
      ],
      "summary": [["Total Income (Line 11)", "11"], ["Total Deductions (Line 27)", "27"], ["Line 28", "28", "tone"]],
      "notes": [
        "Lines 29a, 29b and the tax and payment lines (30 to 37, Schedule J) are the preparer's. Line 20 is the depreciation the books carry - Form 4562 is not worked out here. Map federal income tax expense to Not on This Form - it is an M-1 item, not a deduction."
      ]
    },
    {
      "key": "tax-1120-l",
      "label": "Form 1120 Schedule L (Draft)",
      "basis": "bs",
      "rows": [
        { "heading": "Schedule L - Assets", "prefix": "Schedule L " },
        { "line": "l1", "num": "1", "label": "Cash", "sign": 1, "group": "assets" },
