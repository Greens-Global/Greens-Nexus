        { "line": "l2b", "num": "2b", "label": "Less allowance for bad debts", "sign": 1, "group": "assets" },
        { "line": "l3", "num": "3", "label": "Inventories", "sign": 1, "group": "assets" },
        { "line": "l4", "num": "4", "label": "U.S. government obligations", "sign": 1, "group": "assets" },
        { "line": "l5", "num": "5", "label": "Tax-exempt securities", "sign": 1, "group": "assets" },
        { "line": "l6", "num": "6", "label": "Other current assets", "sign": 1, "group": "assets" },
        { "line": "l7", "num": "7", "label": "Loans to shareholders", "sign": 1, "group": "assets" },
        { "line": "l8", "num": "8", "label": "Mortgage and real estate loans", "sign": 1, "group": "assets" },
        { "line": "l9", "num": "9", "label": "Other investments", "sign": 1, "group": "assets" },
        { "line": "l10a", "num": "10a", "label": "Buildings and other depreciable assets", "sign": 1, "group": "assets" },
        { "line": "l10b", "num": "10b", "label": "Less accumulated depreciation", "sign": 1, "group": "assets" },
        { "line": "l11a", "num": "11a", "label": "Depletable assets", "sign": 1, "group": "assets" },
        { "line": "l11b", "num": "11b", "label": "Less accumulated depletion", "sign": 1, "group": "assets" },
        { "line": "l12", "num": "12", "label": "Land (net of any amortization)", "sign": 1, "group": "assets" },
        { "line": "l13a", "num": "13a", "label": "Intangible assets (amortizable only)", "sign": 1, "group": "assets" },
        { "line": "l13b", "num": "13b", "label": "Less accumulated amortization", "sign": 1, "group": "assets" },
        { "line": "l14", "num": "14", "label": "Other assets", "sign": 1, "group": "assets" },
        { "line": "l15", "num": "15", "label": "Total assets", "calc": ["@group:assets"] },
        { "heading": "Schedule L - Liabilities and Shareholders' Equity", "prefix": "Schedule L " },
        { "line": "l16", "num": "16", "label": "Accounts payable", "sign": 1, "group": "claims" },
        { "line": "l17", "num": "17", "label": "Mortgages, notes, bonds payable in less than 1 year", "sign": 1, "group": "claims" },
        { "line": "l18", "num": "18", "label": "Other current liabilities", "sign": 1, "group": "claims" },
        { "line": "l19", "num": "19", "label": "Loans from shareholders", "sign": 1, "group": "claims" },
        { "line": "l20", "num": "20", "label": "Mortgages, notes, bonds payable in 1 year or more", "sign": 1, "group": "claims" },
        { "line": "l21", "num": "21", "label": "Other liabilities", "sign": 1, "group": "claims" },
        { "line": "l22", "num": "22", "label": "Capital stock", "sign": 1, "group": "claims" },
        { "line": "l23", "num": "23", "label": "Additional paid-in capital", "sign": 1, "group": "claims" },
        { "line": "l24", "num": "24", "label": "Retained earnings - appropriated", "sign": 1, "group": "claims" },
        { "line": "l25", "num": "25", "label": "Retained earnings - unappropriated", "sign": 1, "group": "claims" },
        { "line": "l26", "num": "26", "label": "Adjustments to shareholders' equity", "sign": 1, "group": "claims" },
        { "line": "l27", "num": "27", "label": "Less cost of treasury stock", "sign": 1, "group": "claims" },
        { "line": "l28", "num": "28", "label": "Total liabilities and shareholders' equity", "calc": ["@group:claims"], "grand": true },
        { "line": "lchk", "num": "-", "label": "Line 15 less line 28 (should be 0)", "calc": ["l15", "-l28"] }
      ],
      "summary": [["Total Assets (Line 15)", "l15"], ["Total Liabilities and Equity (Line 28)", "l28"], ["Out of Balance", "lchk"]],
      "notes": [
        "Beginning of the tax year = the balance sheet the day before the period starts; end of the tax year = the balance sheet on its last day. A contra account keeps its minus sign on its own line.",
        "This year's earnings not yet closed and the prior years' retained earnings sit on line 25, so the two totals agree."
      ]
    }
  ],
