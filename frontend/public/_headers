# 'wasm-unsafe-eval' (Aug 6): permits compiling WebAssembly from scripts our CSP
# already allows ('self') - needed by client-side OCR (tesseract.js, Asset
# module). It does NOT enable JS eval. Do NOT add `data:` to script-src for any
# reason - data: scripts are an XSS vector. OCR worker + traineddata must be
# SELF-HOSTED (bundled/public/), never a CDN: connect-src has no CDN entries on
# purpose. This CSP is a PLATFORM file - module owners ask, platform edits.
#
# Framing is SAME-ORIGIN, not denied outright (Jul 30). The PDF Editor module
# hosts its vanilla-JS engine in a same-origin <iframe> (see PdfEditorModule.jsx),
# and a DENY framing policy + `frame-ancestors 'none'` + a `frame-src` without
# 'self' each blocked it independently - the module rendered an empty box on
# Pages while working perfectly on localhost, because Vite never serves this
# file. Third-party framing (the actual clickjacking threat) is still blocked:
# 'self' permits only our own origin. Do NOT go back to DENY/'none' without
# first removing that iframe.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.azurewebsites.net https://*.supabase.co wss://*.supabase.co https://login.microsoftonline.com https://*.microsoftonline.com https://login.microsoft.com https://login.windows.net https://graph.microsoft.com https://cloudflareinsights.com https://nominatim.openstreetmap.org; img-src 'self' data: blob: https://*.supabase.co https://*.tile.openstreetmap.org https://*.arcgisonline.com https://picsum.photos https://fastly.picsum.photos; frame-src 'self' https://login.microsoftonline.com https://*.microsoftonline.com https://login.microsoft.com https://login.windows.net https://login.live.com https://www.youtube.com https://www.youtube-nocookie.com https://www.loom.com https://player.vimeo.com https://www.google.com https://maps.google.com; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# The HTML entry must always revalidate so a deploy's new asset hashes are picked
# up immediately (a stale index → deleted /assets hash → white screen). Hashed
# assets are content-addressed, so cache them forever. (Cloudflare Pages honors
# this; on the GitHub-Pages-origin prod host it's ignored — the index.html boot
# watchdog covers that case, and a Cloudflare cache rule should pin the HTML too.)
/index.html
  Cache-Control: no-cache
# Build identity, polled by a running tab to notice it is on superseded code and
# by the post-deploy gate to wait for the build it just shipped. Must never be
# cached or both of those silently compare against a stale value.
/version.json
  Cache-Control: no-store
  Content-Type: application/json
/assets-404.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# VERIFIED NOT EFFECTIVE on Pages (Jul 30) - kept only to document intent.
# Sub-resources under this glob still come back `max-age=31536000`; only the
# directory's own index.html picks up no-cache, and that comes from Pages' HTML
# handling rather than this rule. Do not rely on it, and do not "fix" the PDF
# engine's caching by editing this block.
#
# What actually protects every unhashed public/ file (the PDF engine AND
# guard.js) is the ?v=<build id> stamp applied to every emitted HTML by
# stampUnhashedAssets in vite.config.js - a new URL per deploy, independent of
# cache headers.
/pdf-editor-app/*
  Cache-Control: no-cache
