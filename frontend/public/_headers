# Framing is SAME-ORIGIN, not denied outright (Jul 30). The PDF Editor module
# hosts its vanilla-JS engine in a same-origin <iframe> (see PdfEditorModule.jsx),
# and a DENY framing policy + `frame-ancestors 'none'` + a `frame-src` without
# 'self' each blocked it independently - the module rendered an empty box on
# Pages while working perfectly on localhost, because Vite never serves this
# file. Third-party framing (the actual clickjacking threat) is still blocked:
# 'self' permits only our own origin. Do NOT go back to DENY/'none' without
# first removing that iframe.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.azurewebsites.net https://*.supabase.co wss://*.supabase.co https://login.microsoftonline.com https://*.microsoftonline.com https://login.microsoft.com https://login.windows.net https://graph.microsoft.com https://cloudflareinsights.com https://nominatim.openstreetmap.org; img-src 'self' data: blob: https://*.supabase.co https://*.tile.openstreetmap.org https://picsum.photos https://fastly.picsum.photos; frame-src 'self' https://login.microsoftonline.com https://*.microsoftonline.com https://login.microsoft.com https://login.windows.net https://login.live.com https://www.youtube.com https://www.youtube-nocookie.com https://www.loom.com https://player.vimeo.com; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# The HTML entry must always revalidate so a deploy's new asset hashes are picked
# up immediately (a stale index → deleted /assets hash → white screen). Hashed
# assets are content-addressed, so cache them forever. (Cloudflare Pages honors
# this; on the GitHub-Pages-origin prod host it's ignored — the index.html boot
# watchdog covers that case, and a Cloudflare cache rule should pin the HTML too.)
/index.html
  Cache-Control: no-cache
# Build identity, polled by a running tab to notice it is on superseded code and
# by the post-deploy gate to wait for the build it just shipped. Must never be
# cached or both of those silently compare against a stale value.
/version.json
  Cache-Control: no-store
  Content-Type: application/json
/assets-404.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The vendored PDF engine has FIXED filenames (no content hash), so it must not
# inherit Pages' default year-long max-age - that is what made a shipped fix
# invisible to anyone who had already opened the editor. vite.config.js stamps
# ?v=<build id> onto these URLs so each deploy busts them; no-cache is the
# belt-and-braces for anything the stamp misses (revalidation is a cheap 304,
# which matters for the 11 MB OCR training data).
/pdf-editor-app/*
  Cache-Control: no-cache
