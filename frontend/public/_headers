/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.azurewebsites.net https://*.supabase.co wss://*.supabase.co https://login.microsoftonline.com https://*.microsoftonline.com https://login.microsoft.com https://login.windows.net https://graph.microsoft.com https://cloudflareinsights.com https://nominatim.openstreetmap.org; img-src 'self' data: blob: https://*.supabase.co https://*.tile.openstreetmap.org https://picsum.photos https://fastly.picsum.photos; frame-src https://login.microsoftonline.com https://*.microsoftonline.com https://login.microsoft.com https://login.windows.net https://login.live.com https://www.youtube.com https://www.youtube-nocookie.com https://www.loom.com https://player.vimeo.com; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# The HTML entry must always revalidate so a deploy's new asset hashes are picked
# up immediately (a stale index → deleted /assets hash → white screen). Hashed
# assets are content-addressed, so cache them forever. (Cloudflare Pages honors
# this; on the GitHub-Pages-origin prod host it's ignored — the index.html boot
# watchdog covers that case, and a Cloudflare cache rule should pin the HTML too.)
/index.html
  Cache-Control: no-cache
/assets-404.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
