<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nexus Signature (DEV) - Outlook Add-in, dev-pointed variant (Sep 17).

  For testing ONLY: sideload this file for your own account (Outlook ->
  Get Add-ins -> My add-ins -> Add a custom add-in -> Add from file) rather
  than uploading it org-wide through the Microsoft 365 admin center. It
  points at dev.nexus.greensglobal.com and the dev backend, both of which
  already have this code live (merged to `dev`) - so the whole compose ->
  fetch signature -> insert flow can be verified for real before anything
  touches production (see manifest.xml for the production version and the
  one-time Entra "Expose an API" setup both variants share - same tenant,
  same app registration, so no extra Entra config is needed to test this).

  A different <Id> and DisplayName from manifest.xml so this can be
  sideloaded and later uninstalled without touching a production install
  that might exist side-by-side.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="MailApp">
  <Id>7b1e4d3a-9f2c-4a5e-8d6b-1c3a7e9f2b4d</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Greens Global</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Nexus Signature (Dev)" />
  <Description DefaultValue="DEV/TEST ONLY - automatically inserts your Nexus company signature when you compose a new message or reply." />
  <IconUrl DefaultValue="https://dev.nexus.greensglobal.com/outlook-addin/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://dev.nexus.greensglobal.com/outlook-addin/icon-128.png" />
  <SupportUrl DefaultValue="https://dev.nexus.greensglobal.com" />
  <AppDomains>
    <AppDomain>https://dev.nexus.greensglobal.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.10" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://dev.nexus.greensglobal.com/outlook-addin/commands-dev.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <!-- LaunchEvent (event-based activation) is only valid under the Mail 1.1
         schema, not 1.0 - it must live in this nested VersionOverridesV1_1
         block (see manifest.xml for the full explanation). -->
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <Runtime resid="Runtime.Url" lifetime="short">
              <Override type="javascript" resid="Commands.Url" />
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url" />
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <!-- OnNewMessageCompose already covers reply/reply-all/forward;
                     there is no separate "OnMessageReplyCompose" event type. -->
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageComposeHandler" SendMode="SoftBlock" />
                <!-- Recipient targeting (Sep 22) - see manifest.xml for the full
                     reasoning; this re-checks with the final To/Cc list at Send. -->
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="SoftBlock" />
              </LaunchEvents>
              <SourceLocation resid="Runtime.Url" />
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://dev.nexus.greensglobal.com/outlook-addin/icon-16.png" />
          <bt:Image id="Icon.32x32" DefaultValue="https://dev.nexus.greensglobal.com/outlook-addin/icon-32.png" />
          <bt:Image id="Icon.80x80" DefaultValue="https://dev.nexus.greensglobal.com/outlook-addin/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Runtime.Url" DefaultValue="https://dev.nexus.greensglobal.com/outlook-addin/commands-dev.html" />
          <bt:Url id="Commands.Url" DefaultValue="https://dev.nexus.greensglobal.com/outlook-addin/commands-dev.js" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GetStarted.Title" DefaultValue="Nexus Signature (Dev) is ready" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="GetStarted.Description" DefaultValue="DEV/TEST build. Your Nexus company signature is inserted automatically when you start a new message or reply." />
        </bt:LongStrings>
      </Resources>
      <WebApplicationInfo>
        <Id>be6f1e37-83a8-4a29-8b46-96d20beb32f9</Id>
        <Resource>api://be6f1e37-83a8-4a29-8b46-96d20beb32f9</Resource>
        <Scopes>
          <Scope>access_as_user</Scope>
          <Scope>openid</Scope>
          <Scope>profile</Scope>
        </Scopes>
      </WebApplicationInfo>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
